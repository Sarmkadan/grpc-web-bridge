{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "GrpcWebBridge": "Debug"
    }
  },
  "AllowedHosts": "*",
  "GrpcWebBridge": {
    "Environment": "Development",
    "InstanceName": "grpc-web-bridge-dev",
    "EnableLogging": true,
    "EnableSwagger": true,
    "EnableMetrics": true,
    "EnableCors": true,
    "RequireAuthentication": false,
    "MaxStreamCount": 10000,
    "StreamIdleTimeoutSeconds": 300,
    "StreamHeartbeatIntervalSeconds": 30,
    "MaxMessageSize": 4194304,
    "DefaultTimeoutMilliseconds": 30000,
    "CompressResponses": true,
    "CompressionLevel": 6,
    "AllowedOrigins": [
      "*"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS"
    ]
  },
  "Authentication": {
    "JwtAudience": "grpc-web-bridge",
    "JwtIssuer": "sarmkadan.com",
    "JwtExpirationMinutes": 60
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://0.0.0.0:5000"
      },
      "https": {
        "Url": "https://0.0.0.0:5001"
      }
    }
  }
}
