# Environment variables for gRPC-Web Bridge
# Copy this file to .env and fill in the values

# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000;https://+:5001

# Logging Configuration
LOG_LEVEL=Information
LOG_FILE_PATH=/app/logs/application.log
LOG_RETENTION_DAYS=30

# gRPC-Web Bridge Settings
GRPC_WEB_BRIDGE__ENVIRONMENT=Production
GRPC_WEB_BRIDGE__INSTANCENAME=grpc-web-bridge-prod
GRPC_WEB_BRIDGE__ENABLELOGGING=true
GRPC_WEB_BRIDGE__ENABLESWAGGER=false
GRPC_WEB_BRIDGE__ENABLEMETRICS=true
GRPC_WEB_BRIDGE__ENABLECORS=true
GRPC_WEB_BRIDGE__REQUIREAUTHENTICATION=true

# Stream Configuration
GRPC_WEB_BRIDGE__MAXSTREAMCOUNT=5000
GRPC_WEB_BRIDGE__STREAMIDLETIMEOUTSECONDS=300
GRPC_WEB_BRIDGE__STREAMHEARTBEATINTERVALSECONDS=30

# Message Configuration
GRPC_WEB_BRIDGE__MAXMESSAGESIZE=4194304
GRPC_WEB_BRIDGE__DEFAULTTIMEOUTMILLISECONDS=30000

# Response Configuration
GRPC_WEB_BRIDGE__COMPRESSRESPONSES=true
GRPC_WEB_BRIDGE__COMPRESSIONLEVEL=6

# CORS Configuration
GRPC_WEB_BRIDGE__ALLOWEDORIGINS__0=https://app.example.com
GRPC_WEB_BRIDGE__ALLOWEDORIGINS__1=https://admin.example.com
GRPC_WEB_BRIDGE__ALLOWEDORIGINS__2=https://mobile.example.com

# Authentication Configuration
AUTHENTICATION__JWTISSUER=https://auth.example.com
AUTHENTICATION__JWTAUDIENCE=grpc-web-bridge
AUTHENTICATION__JWTEXPIRATIONMINUTES=60
AUTHENTICATION__APIKEYHEADER=X-API-Key

# TLS/SSL Configuration
KESTREL__ENDPOINTS__HTTP__URL=http://0.0.0.0:5000
KESTREL__ENDPOINTS__HTTPS__URL=https://0.0.0.0:5001
CERTIFICATE_PASSWORD=your-certificate-password
CERTIFICATE_PATH=/etc/ssl/certs/server.pfx

# Rate Limiting Configuration
RATELIMITING__ENABLED=true
RATELIMITING__REQUESTSPERSECOND=100
RATELIMITING__BURSTSIZE=150
RATELIMITING__WINDOWSIZESECONDS=1

# Service Registry Configuration
SERVICE_REGISTRY__ENABLEAUTODISCOVERY=false
SERVICE_REGISTRY__DISCOVERYENDPOINT=http://consul:8500
SERVICE_REGISTRY__REFRESHINTERVALSECONDS=30

# Monitoring and Observability
MONITORING__ENABLEPROMETHEUS=true
MONITORING__PROMETHEUSENDPOINT=/metrics
MONITORING__ENABLETRACING=true
MONITORING__TRACINGENDHPOINT=http://jaeger:14250
MONITORING__SAMPLERATE=0.1

# Database Configuration (if using persistent cache)
DATABASE__CONNECTION_STRING=Server=postgres:5432;Database=grpc_web_bridge;User Id=user;Password=password;
DATABASE__ENABLE_MIGRATIONS=true

# Elasticsearch Configuration (for centralized logging)
ELASTICSEARCH__URI=http://elasticsearch:9200
ELASTICSEARCH__ENABLED=false
ELASTICSEARCH__INDEXFORMAT=grpc-web-bridge-{0:yyyy.MM.dd}

# Webhook Configuration
WEBHOOKS__ENABLED=true
WEBHOOKS__ENDPOINT_0=https://webhook.example.com/events

# Redis Configuration (if using distributed caching)
REDIS__CONNECTION_STRING=redis:6379
REDIS__ENABLED=false
REDIS__CACHE_EXPIRATION_MINUTES=5

# Backend Services
# Format: BACKEND_SERVICES__<INDEX>__<PROPERTY>=value
BACKEND_SERVICES__0__SERVICENAME=UserService
BACKEND_SERVICES__0__ADDRESS=grpc://user-service:50051
BACKEND_SERVICES__0__HEALTHCHECKENABLED=true

BACKEND_SERVICES__1__SERVICENAME=OrderService
BACKEND_SERVICES__1__ADDRESS=grpc://order-service:50051
BACKEND_SERVICES__1__HEALTHCHECKENABLED=true

BACKEND_SERVICES__2__SERVICENAME=PaymentService
BACKEND_SERVICES__2__ADDRESS=grpc://payment-service:50051
BACKEND_SERVICES__2__HEALTHCHECKENABLED=true

# API Keys (for API key authentication)
# Format: APIKEYS__<KEY_ID>=<PERMISSIONS>
APIKEYS__KEY_12345=read,write,admin
APIKEYS__KEY_67890=read,write

# Feature Flags
FEATURE__ENABLEHEALTHCHECKS=true
FEATURE__ENABLEMETRICS=true
FEATURE__ENABLEWEBHOOKS=true
FEATURE__ENABLECACHING=true
FEATURE__ENABLERATELIMITING=true

# Performance Tuning
PERFORMANCE__MAX_BUFFER_SIZE=10485760
PERFORMANCE__CONNECTION_TIMEOUT_MS=10000
PERFORMANCE__THREAD_POOL_SIZE=100

# Debug Mode
DEBUG=false
DEBUG_GRPC_MARSHALLING=false
DEBUG_AUTHENTICATION=false
DEBUG_STREAMING=false

# Miscellaneous
INSTANCE_ID=bridge-instance-1
REGION=us-east-1
ENVIRONMENT_TAG=production
VERSION=1.2.0
