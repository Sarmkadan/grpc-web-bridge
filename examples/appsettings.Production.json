{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information",
      "Microsoft.AspNetCore.Hosting": "Information",
      "GrpcWebBridge": "Information",
      "GrpcWebBridge.Services": "Debug",
      "GrpcWebBridge.Middleware": "Debug"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff zzz"
    }
  },
  "AllowedHosts": "*",
  "GrpcWebBridge": {
    "Environment": "Production",
    "InstanceName": "grpc-web-bridge-prod-01",
    "EnableLogging": true,
    "EnableSwagger": false,
    "EnableMetrics": true,
    "EnableCors": true,
    "EnableRateLimiting": true,
    "EnableRequestLogging": true,
    "RequireAuthentication": true,
    "MaxStreamCount": 5000,
    "StreamIdleTimeoutSeconds": 300,
    "StreamHeartbeatIntervalSeconds": 30,
    "MaxMessageSize": 4194304,
    "DefaultTimeoutMilliseconds": 30000,
    "CompressResponses": true,
    "CompressionLevel": 6,
    "AllowedOrigins": [
      "https://app.example.com",
      "https://admin.example.com",
      "https://mobile.example.com"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization",
      "X-Request-ID",
      "X-Correlation-ID",
      "User-Agent"
    ],
    "ExposedHeaders": [
      "X-Total-Count",
      "X-Page-Number",
      "X-Request-ID"
    ],
    "AllowCredentials": true,
    "PreflightCacheDurationSeconds": 86400,
    "CacheSettings": {
      "Enabled": true,
      "DefaultTtlSeconds": 300,
      "MaxCacheSize": 1000
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "RequestsPerSecond": 100,
    "BurstSize": 150,
    "WindowSizeSeconds": 1,
    "PerClientLimit": 50
  },
  "Authentication": {
    "JwtIssuer": "https://auth.example.com",
    "JwtAudience": "grpc-web-bridge",
    "JwtExpirationMinutes": 60,
    "ApiKeyHeader": "X-API-Key",
    "ValidateTokenSignature": true,
    "ValidateLifetime": true,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "RequireExpirationTime": true,
    "SupportedAlgorithms": [
      "RS256",
      "HS256",
      "ES256"
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://0.0.0.0:5000",
        "Protocols": "Http1AndHttp2"
      },
      "https": {
        "Url": "https://0.0.0.0:5001",
        "Protocols": "Http1AndHttp2",
        "Certificate": {
          "Path": "/etc/ssl/certs/server.pfx",
          "Password": "${CERTIFICATE_PASSWORD}"
        }
      }
    },
    "Limits": {
      "MaxRequestBodySize": 4194304,
      "MaxRequestHeadersTotalSize": 16384,
      "RequestHeadersTimeout": "00:00:30",
      "KeepAliveTimeout": "00:02:00"
    }
  },
  "ServiceRegistry": {
    "EnableAutoDiscovery": false,
    "DiscoveryEndpoint": null,
    "RefreshIntervalSeconds": 30,
    "HealthCheckIntervalSeconds": 10,
    "HealthCheckTimeout": "00:00:05"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "GrpcWebBridge": "Information"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff zzz"
    },
    "File": {
      "Enabled": true,
      "Path": "/var/log/grpc-web-bridge/application-.log",
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 30,
      "FileSizeLimitBytes": 104857600,
      "RollOnFileSizeLimit": true
    },
    "Elasticsearch": {
      "Enabled": false,
      "Uri": "http://elasticsearch:9200",
      "IndexFormat": "grpc-web-bridge-{0:yyyy.MM.dd}",
      "TypeName": "_doc"
    }
  },
  "Monitoring": {
    "EnablePrometheus": true,
    "PrometheusEndpoint": "/metrics",
    "EnableTracing": true,
    "TracingEndpoint": "http://jaeger:14250",
    "SampleRate": 0.1,
    "EnableHealthChecks": true,
    "HealthCheckInterval": 30
  },
  "Webhooks": {
    "Enabled": true,
    "Endpoints": [
      {
        "Event": "StreamClosed",
        "Url": "https://webhook.example.com/stream-closed",
        "Retry": 3,
        "Timeout": 5000
      },
      {
        "Event": "ServiceRegistered",
        "Url": "https://webhook.example.com/service-registered",
        "Retry": 2,
        "Timeout": 5000
      }
    ]
  },
  "BackendServices": [
    {
      "ServiceName": "UserService",
      "Address": "grpc://user-service:50051",
      "HealthCheckEnabled": true,
      "HealthCheckPath": "",
      "Metadata": {
        "version": "1.0.0",
        "environment": "production"
      }
    },
    {
      "ServiceName": "OrderService",
      "Address": "grpc://order-service:50051",
      "HealthCheckEnabled": true,
      "Metadata": {
        "version": "1.0.0",
        "environment": "production"
      }
    },
    {
      "ServiceName": "PaymentService",
      "Address": "grpc://payment-service:50051",
      "HealthCheckEnabled": true,
      "Metadata": {
        "version": "2.0.0",
        "environment": "production"
      }
    }
  ]
}
